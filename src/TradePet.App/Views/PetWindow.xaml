<Window Language="{l:Language}" x:Class="TradePet.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        xmlns:controls="clr-namespace:TradePet.App.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{l:Text Key=S7f999459912f57da}" Width="160" Height="230" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        Topmost="{Binding IsTopmost}" Opacity="{Binding PetOpacity}">
    <Window.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Background="#101721" BorderBrush="#3A4B60" BorderThickness="1" Padding="6"
                     MinWidth="176" OverridesDefaultStyle="True" SnapsToDevicePixels="True"
                     HasDropShadow="True" FontFamily="Microsoft YaHei UI" FontSize="14">
            <ContextMenu.Template>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.42" />
                        </Border.Effect>
                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="#F2F5F4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="15,10" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="MenuItemBorder" Property="Background" Value="#1B6655" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="MenuItemBorder" Property="Background" Value="#1A3B35" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Margin" Value="8,5" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Background" Value="#2B3A4B" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Separator}">
                                <Border Height="1" Background="{TemplateBinding Background}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="{l:Text Key=S02b74652eeae4c95}" Click="ShowQuickCard_Click" />
            <MenuItem Header="{l:Text Key=S7482b58d44b922f6}" Command="{Binding ShowDailyTradingReportCommand}" />
            <MenuItem Header="{l:Text Key=Sfd62c7a47ec1aa6a}" Command="{Binding ShowMacroCalendarCommand}" />
            <MenuItem Header="{l:Text Key=S7a632e2762cb093d}" Command="{Binding ShowPlanPageCommand}" />
            <MenuItem Header="{l:Text Key=S39f12fd8d6936711}" Command="{Binding ShowLossZonesPageCommand}" />
            <MenuItem Header="{l:Text Key=S2b9f7901b72f0549}" Command="{Binding ShowReviewPageCommand}" />
            <MenuItem Header="{l:Text Key=Sf0849eecd0bf645e}" Command="{Binding ShowQuickReviewCommand}" />
            <MenuItem Header="{l:Text Key=S371d943a67b5707e}" Command="{Binding ShowEntryReasonCommand}" />
            <MenuItem Header="{l:Text Key=S728a7e32a14148be}" Command="{Binding OpenReleasePageCommand}">
                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UpdateAvailable, Converter={StaticResource UiTranslation}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{l:Text Key=S67819401c5dcb20e}" Command="{Binding ShowTimelinePageCommand}" />
            <MenuItem Header="{l:Text Key=Sd89995d3d5394519}" Command="{Binding ShowSettingsPageCommand}" />
            <Separator />
            <MenuItem Header="{l:Text Key=S7438a1abd7803ce5}" Command="{Binding ShowMainWindowCommand}" />
            <MenuItem Click="ToggleMiniPosition_Click">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{l:Text Key=S49e4723edb996902}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MiniPositionVisible, Converter={StaticResource UiTranslation}}" Value="True">
                                <Setter Property="Header" Value="{l:Text Key=Se0bbc7a4bcda953b}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{l:Text Key=S30ef504d19356447}" Command="{Binding HidePetCommand}" />
            <Separator />
            <MenuItem Header="{l:Text Key=S0a2e2fa072eca9b7}" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <controls:PetSpriteControl x:Name="PetSprite"
                                   Width="134" Height="146" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Activity="{Binding PetActivity}"
                                   AtlasPath="Assets/baoer-pet/spritesheet.webp"
                                   PlaybackRate="0.65"
                                   MouseEnter="PetSprite_MouseEnter"
                                   MouseLeave="PetSprite_MouseLeave"
                                   MouseLeftButtonDown="PetSprite_MouseLeftButtonDown" />

        <primitives:Popup x:Name="QuickCardPopup"
                          Placement="Custom" CustomPopupPlacementCallback="PlaceQuickCard"
                          AllowsTransparency="True" PopupAnimation="None"
                          StaysOpen="True" Focusable="False">
        <Grid x:Name="QuickCardHost" Width="370" Height="340"
              MouseEnter="QuickCard_MouseEnter" MouseLeave="QuickCard_MouseLeave">
            <Border Width="358" Height="330" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="#121923" BorderBrush="#2B3746" BorderThickness="1"
                    CornerRadius="18" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Text Key=Sf360553803360e5b}" Foreground="#F0F5F2" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding AccountLabel, Converter={StaticResource UiTranslation}}" Foreground="#84918D" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ServerDateText, Converter={StaticResource UiTranslation}}" Foreground="#A7B2AE" FontSize="10" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ConnectionText, Converter={StaticResource UiTranslation}}" Foreground="#54D6B2" FontSize="10"
                                       TextTrimming="CharacterEllipsis" MaxWidth="126" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Text Key=Scfa10e46213dbfb6}" Foreground="#96A29E" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                        Foreground="{Binding TotalPnlColor}"
                        FontSize="28" FontWeight="Bold" HorizontalAlignment="Right">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                    <Binding Path="SupportsTradeHistory"/>
                                    <Binding Path="TotalPnl"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,5,0,0" Background="#0D141D" CornerRadius="8" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Text Key=S800b6cbc79da6bdc}" Foreground="#71807B" FontSize="9" />
                                <TextBlock Foreground="{Binding RealizedPnlColor}" FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                            <Binding Path="SupportsTradeHistory"/>
                                            <Binding Path="RealizedPnl"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:Text Key=Scf9c4de10c7bb6a0}" Foreground="#71807B" FontSize="9" />
                                <TextBlock Text="{Binding FloatingPnl, StringFormat={}{0:+0.##;-0.##;0}, Converter={StaticResource UiTranslation}}" Foreground="{Binding FloatingPnlColor}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Text Key=Sbaa966a4c3415fc4}" Foreground="#71807B" FontSize="9" />
                                <TextBlock Foreground="{Binding HighWaterPnlColor}" FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                            <Binding Path="SupportsTradeHistory"/>
                                            <Binding Path="HighWaterPnl"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{l:Text Key=S61327d1df6610890}" Foreground="#71807B" FontSize="9" />
                                <TextBlock Foreground="{Binding GivebackColor}" FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="0.##">
                                            <Binding Path="SupportsTradeHistory"/>
                                            <Binding Path="Giveback"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Text Key=S761e9e08d90ede1f}" Foreground="#71807B" FontSize="9" />
                            <TextBlock Text="{Binding TradeCount, StringFormat={l:Text Key=S2feb49e0d6822930}, Converter={StaticResource UiTranslation}}" Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{l:Text Key=Sfa272c804373d155}" Foreground="#71807B" FontSize="9" />
                            <TextBlock Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12">
                                <Run Text="{Binding WinCount, Converter={StaticResource UiTranslation}}" Foreground="{Binding WinCountColor}"/><Run Text=" / "/><Run Text="{Binding LossCount, Converter={StaticResource UiTranslation}}" Foreground="{Binding LossCountColor}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Text Key=S3584ce01013d64cd}" Foreground="#71807B" FontSize="9" />
                            <TextBlock Text="{Binding ConsecutiveLosses, StringFormat={l:Text Key=S2feb49e0d6822930}, Converter={StaticResource UiTranslation}}" Foreground="{Binding ConsecutiveLossesColor}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{l:Text Key=Sc04bdce4d8106dc7}" Foreground="#71807B" FontSize="9" />
                            <TextBlock Foreground="#EAF0ED" FontWeight="SemiBold" FontSize="12">
                                <Run Text="{Binding OpenPositionCount, Converter={StaticResource UiTranslation}}"/><Run Text="{l:Text Key=S34389fe8f994f65a}"/><Run Text="{Binding CurrentExposure, StringFormat={}{0:0.##}, Converter={StaticResource UiTranslation}}"/><Run Text="{l:Text Key=S3220fa6671304d4c}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Margin="0,7,0,0" Background="#161F2A" BorderBrush="#273546" BorderThickness="1" CornerRadius="8" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text Key=Sdc579e0e66072a51}" Foreground="#84918D" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="{Binding RiskText, Converter={StaticResource UiTranslation}}" Foreground="#F4C66A" FontWeight="SemiBold" FontSize="10"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" MaxWidth="240" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" Margin="0,7,0,0" Background="#10231F" CornerRadius="8" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionCard, Converter={StaticResource UiTranslation}}" Foreground="#C9D5D0" FontSize="10"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding MaximumExposure, StringFormat={l:Text Key=S9c904d56b82217ad}, Converter={StaticResource UiTranslation}}"
                                       Foreground="#71807B" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{l:Text Key=Sf0849eecd0bf645e}" Click="OpenQuickReview_Click" Margin="0,0,5,0" Padding="8,6" />
                        <Button Grid.Column="1" Content="{l:Text Key=S7438a1abd7803ce5}" Click="OpenConsole_Click" Margin="5,0,0,0" Padding="8,6" />
                    </Grid>
                </Grid>
            </Border>
            <Path Data="M 0,0 L 13,8 L 0,16 Z" Fill="#121923" Stroke="#2B3746"
                  Width="13" Height="16" Stretch="Fill" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,0,54" />
        </Grid>
        </primitives:Popup>

        <primitives:Popup x:Name="ReviewCardPopup" Placement="Custom" CustomPopupPlacementCallback="PlaceQuickCard"
                          AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" Focusable="False">
            <Border Background="#121923" BorderBrush="#2B3746" BorderThickness="1" CornerRadius="12" Margin="8">
                <ContentControl x:Name="ReviewCardHost" />
            </Border>
        </primitives:Popup>

        <primitives:Popup x:Name="SpeechBubblePopup"
                          Placement="Top"
                          HorizontalOffset="0" VerticalOffset="-8"
                          AllowsTransparency="True" PopupAnimation="Fade"
                          StaysOpen="True" Focusable="False">
            <Grid Width="306" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                </Grid.RowDefinitions>
                <Border Background="#151D27" BorderBrush="#F0B85C" BorderThickness="1.5"
                        CornerRadius="16" Padding="17,13">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{l:Text Key=Se55d87c97bfec61d}" Foreground="#8E9A96" FontSize="10" />
                        <TextBlock Text="{Binding BubbleHeadline, Converter={StaticResource UiTranslation}}" Foreground="#F7C96E"
                                   FontSize="18" FontWeight="Bold" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BubbleDetails, Converter={StaticResource UiTranslation}}" Foreground="#EEF3F1"
                                   FontSize="12" LineHeight="19" Margin="0,7,0,0"
                                   TextWrapping="Wrap" MaxWidth="270" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding IsAlertActionVisible, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="{l:Text Key=S940ae884b2cfa51d}" Click="AcknowledgeAlert_Click" Padding="8,3"/>
                            <Button Content="{l:Text Key=Sc263d3d7fe942e3f}" Click="SnoozeAlert_Click" Padding="8,3" Margin="6,0,0,0"/>
                            <Button Content="{l:Text Key=S65e9cf200571eb31}" Click="MuteAlert_Click" IsEnabled="{Binding CanMuteCurrentAlert}" Padding="8,3" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Border Visibility="{Binding IsBubbleLossZoneVisible, Converter={StaticResource BoolToVisibility}}"
                                Background="#2A171C" BorderBrush="#8E3E4B" BorderThickness="1"
                                CornerRadius="10" Padding="11,9" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding BubbleZoneSymbol, Converter={StaticResource UiTranslation}}" Foreground="#F3F5F4"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{l:Text Key=S9cb57be3d7a3316c}" Foreground="#F07B7B" FontSize="10"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding BubbleZoneRangeText, Converter={StaticResource UiTranslation}}" Foreground="#FFD4D8"
                                           FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding BubbleZonePositionPercent}"
                                             Height="8" Margin="0,8,0,0" Background="#4A252C"
                                             Foreground="#F07B7B" BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border Background="#4A252C" CornerRadius="4" />
                                                <Border x:Name="PART_Indicator" Background="#F07B7B"
                                                        HorizontalAlignment="Left" CornerRadius="4" />
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BubbleZoneLowText, Converter={StaticResource UiTranslation}}" Foreground="#A99699" FontSize="8" />
                                    <TextBlock Grid.Column="1" Text="{Binding BubbleZoneCurrentText, Converter={StaticResource UiTranslation}}" Foreground="#FFD4D8"
                                               FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BubbleZoneHighText, Converter={StaticResource UiTranslation}}" Foreground="#A99699"
                                               FontSize="8" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding BubbleZoneCenterText, Converter={StaticResource UiTranslation}}" Foreground="#CFADB1" FontSize="9" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding BubbleZoneStatsText, Converter={StaticResource UiTranslation}}" Foreground="#F0A3AB" FontSize="10" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding BubbleZonePnlText, Converter={StaticResource UiTranslation}}" Foreground="#CFADB1" FontSize="9" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Path Grid.Row="1" Data="M 0,0 L 18,0 L 9,11 Z"
                      Width="18" Height="11" Stretch="Fill"
                      Fill="#151D27" Stroke="#F0B85C" StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0" />
            </Grid>
        </primitives:Popup>
    </Grid>
</Window>
