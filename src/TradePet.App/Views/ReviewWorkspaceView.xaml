                <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="交易想法分组" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding Campaigns}"><ItemsControl.ItemTemplate><DataTemplate>
