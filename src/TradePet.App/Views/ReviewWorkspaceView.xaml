                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8"><StackPanel>
                        <TextBlock x:Name="ReviewGuidePlaybook" Text="策略规则模板（保存即新版本）" Style="{StaticResource SectionTitleStyle}"/>
