                    <TextBlock Text="关联策略（可选）" Style="{StaticResource EditorLabel}"/><TextBlock Text="{Binding OpportunityPlaybookLabel}" TextWrapping="Wrap"/><Button Content="关联选中的已保存策略" Command="{Binding UseLoadedOpportunityPlaybookCommand}" Margin="0,5,0,3" Padding="7,5"/>
                    <WrapPanel><StackPanel><TextBlock Text="参考入场" Style="{StaticResource EditorLabel}"/><TextBox Width="80" Text="{Binding OpportunityEntry}" Style="{StaticResource CompactInput}" MinWidth="80"/></StackPanel><StackPanel><TextBlock Text="参考止损" Style="{StaticResource EditorLabel}"/><TextBox Width="80" Text="{Binding OpportunityStop}" Style="{StaticResource CompactInput}" MinWidth="80"/></StackPanel><StackPanel><TextBlock Text="参考目标" Style="{StaticResource EditorLabel}"/><TextBox Width="80" Text="{Binding OpportunityTarget}" Style="{StaticResource CompactInput}" MinWidth="80"/></StackPanel></WrapPanel>
                    <TextBlock Text="预设条件" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding OpportunityConditions}" ToolTip="当时预先观察的条件" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
