        <TabItem Header="策略与改进">
            <ScrollViewer x:Name="ReviewGuideImprovement" VerticalScrollBarVisibility="Auto"><Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
