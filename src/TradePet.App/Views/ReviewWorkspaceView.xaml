                                    </DockPanel>
                                    <TextBlock Text="规则名称" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="核对依据" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{Binding RuleEditorError}" Foreground="#E5B965" TextWrapping="Wrap"/>
                        <Button Content="保存策略版本" Command="{Binding SavePlaybookCommand}" IsEnabled="{Binding CanSavePlaybookRules}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"/>
                        <TextBlock Text="已保存策略（选择后可继续完善）" Style="{StaticResource EditorLabel}"/><ItemsControl ItemsSource="{Binding Playbooks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="#8491A0"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                    <Border Style="{StaticResource PageCardStyle}" Padding="12"><StackPanel>
                        <TextBlock Text="交易想法分组" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="把围绕同一判断的多笔交易放在一起复盘。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,7"/>
                        <TextBlock Text="分组名称" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CampaignName}" Style="{StaticResource CompactInput}"/>
                        <Button Content="加入档案中勾选的交易" Command="{Binding UseSelectedCampaignTradesCommand}" Margin="0,5,0,5"/>
                        <TextBlock Text="成员交易编号（可补填）" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CampaignMembers}" ToolTip="position ID，逗号分隔" Style="{StaticResource CompactInput}"/>
                        <TextBlock Text="共同交易想法" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CampaignThesis}" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/><Button Content="保存分组" Command="{Binding SaveCampaignCommand}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <Border Style="{StaticResource PageCardStyle}" Padding="12"><StackPanel>
