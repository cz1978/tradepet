<ListBox x:Name="SavedArchiveReviews" SelectionChanged="SavedArchiveReviews_SelectionChanged" ItemsSource="{Binding SavedReviews}" SelectedItem="{Binding SelectedSavedReview, Mode=TwoWay}"
