<UserControl x:Class="TradePet.App.Views.ReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TradePet.App.Controls"
             UseLayoutRounding="True">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveReviewCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding MarkReviewedCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousTradeCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextTradeCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,8,6" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="1,0,0,2" />
        </Style>
        <Style x:Key="FilterTextInput" TargetType="TextBox" BasedOn="{StaticResource CompactInput}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="FilterComboInput" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <Style x:Key="FilterPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <DataTemplate x:Key="DashboardBarTemplate">
            <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch" Padding="5,7" Margin="0,0,0,3" ToolTip="{Binding Detail}">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Height="5" Margin="0,6,0,4" Background="#263142">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding FilledWidth}"/><ColumnDefinition Width="{Binding EmptyWidth}"/></Grid.ColumnDefinitions>
                        <Border Background="{Binding Color}" CornerRadius="2"/>
                    </Grid>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="ReviewStatusPanel" Margin="3,0,3,8">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EditorSaveStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                       AutomationProperties.Name="编辑保存状态" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Visibility="{Binding HasEditorSaveIssue, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <Button Content="保留本地副本" Command="{Binding KeepLocalDraftCommand}" ToolTip="保留当前输入，继续编辑或稍后重试保存" Margin="0,0,6,0" />
                <Button Content="放弃本地并重载" Command="{Binding DiscardAndReloadEditorCommand}" ToolTip="明确放弃当前本地副本，并读取已持久化版本" />
                <TextBlock Text="保留副本后可继续编辑并人工合并；退出失败时会提供 JSON 恢复文件。" Style="{StaticResource MutedTextStyle}" Margin="8,3,0,0" />
            </WrapPanel>
        </StackPanel>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                SelectedIndex="{Binding WorkspaceTabIndex, Mode=TwoWay}" SelectionChanged="WorkspaceTabs_SelectionChanged">
        <TabItem Header="总览">
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding DashboardScope}" Style="{StaticResource MutedTextStyle}" Margin="3,7,3,10" TextWrapping="Wrap"/>
                    <Border x:Name="ReviewGuideFilters" Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Button Content="应用筛选" Command="{Binding RefreshCommand}" Style="{StaticResource FilterPrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Expander IsExpanded="False" Margin="0,0,100,0">
                                <Expander.Header><TextBlock Text="筛选、保存方案与样本对照" FontWeight="SemiBold" Margin="0,7,0,7"/></Expander.Header>
                                <StackPanel Margin="0,10,-100,0">
                            <WrapPanel>
                                <StackPanel Width="190" Margin="0,0,8,6"><TextBlock Text="搜索（票号/仓位/笔记）" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索 ticket、position、笔记正文" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="策略" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Strategy}" ToolTip="策略" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="形态" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Setup}" ToolTip="形态" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,6"><TextBlock Text="标签（逗号分隔）" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Tags}" ToolTip="多个标签用逗号分隔" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="92" Margin="0,0,8,6"><TextBlock Text="标签匹配" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding TagModeOptions}" SelectedItem="{Binding TagMode}" ToolTip="标签任一或全部" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="复盘状态" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="复盘状态" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="执行评价" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding AssessmentFilterOptions}" SelectedItem="{Binding AssessmentFilter}" ToolTip="执行评价" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="130" Margin="0,0,8,6"><TextBlock Text="交易想法 ID" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding CampaignFilter}" ToolTip="交易想法 ID" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="排序" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" ToolTip="排序" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="对照方式" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding ComparisonModeOptions}" SelectedItem="{Binding ComparisonMode}" ToolTip="分析对照方式" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Margin="0,0,0,6"><TextBlock Text="执行" Style="{StaticResource FilterLabel}"/><Button Content="应用筛选" Command="{Binding RefreshCommand}" Style="{StaticResource FilterPrimaryButton}"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel><StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="筛选方案名称" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding FilterName}" ToolTip="给当前筛选方案命名" Style="{StaticResource FilterTextInput}"/></StackPanel><StackPanel Margin="0,0,8,6"><TextBlock Text="保存" Style="{StaticResource FilterLabel}"/><Button Content="保存筛选" Command="{Binding SaveFilterCommand}" Style="{StaticResource FilterButton}"/></StackPanel><ItemsControl ItemsSource="{Binding SavedFilters}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" ToolTip="{Binding Scope}" Command="{Binding ApplyCommand}" Margin="0,3,5,6" Padding="7,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="ReviewGuideMetrics" ItemsSource="{Binding Metrics}" ToolTip="指标使用全部筛选交易。净盈亏包含费用；胜率＝盈利笔数÷盈利与亏损笔数之和，保本交易不计入分母；盈亏因子＝总盈利÷总亏损绝对值；期望值＝每笔平均净盈亏。">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="11" MinHeight="82">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueColor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <ComboBox x:Name="PerformanceChartSelector" DockPanel.Dock="Right" Width="175" ItemsSource="{Binding PerformanceCharts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPerformanceChart}" AutomationProperties.Name="收益与风险图表类型"/>
                                <TextBlock Text="收益与风险" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedPerformanceChart.Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <controls:ReviewPerformanceChart x:Name="PerformanceChart" Height="245" Series="{Binding SelectedPerformanceChart}" AutomationProperties.Name="收益与风险曲线"/>
                            <TextBlock Text="{Binding SelectedPerformanceChart.SampleSummary}" Style="{StaticResource MutedTextStyle}" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8" Visibility="{Binding HasDashboardSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AnalysisDrilldownTitle}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="打开档案查看成交、笔记和回放。" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,8"/>
                            <ListView ItemsSource="{Binding AnalysisDrilldown}" MaxHeight="195"><ListView.View><GridView>
                                <GridViewColumn Header="Position" Width="80" DisplayMemberBinding="{Binding PositionId}"/>
                                <GridViewColumn Header="最终平仓" Width="125" DisplayMemberBinding="{Binding ClosedAt}"/>
                                <GridViewColumn Header="品种" Width="95" DisplayMemberBinding="{Binding Symbol}"/>
                                <GridViewColumn Header="方向" Width="50" DisplayMemberBinding="{Binding Side}"/>
                                <GridViewColumn Header="净盈亏" Width="85" DisplayMemberBinding="{Binding NetPnl}"/>
                                <GridViewColumn Header="档案" Width="60"><GridViewColumn.CellTemplate><DataTemplate><Button Content="打开" Command="{Binding OpenCommand}" Padding="7,2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView></ListView.View></ListView>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DashboardRiskMetrics}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="10">
                                <StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueColor}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,3"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="本期复盘重点" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="从统计事实定位值得核对的交易。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8"/>
                                <ItemsControl ItemsSource="{Binding DashboardInsights}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看交易" Command="{Binding OpenCommand}" Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" Padding="6,2"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ReviewGuideQuality" Text="数据质量" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding QualitySummary}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding Quality}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Command="{Binding OpenCommand}" ToolTip="{Binding Detail}" Padding="3" Margin="0,1" HorizontalContentAlignment="Stretch">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Fraction}" Foreground="#AAB4C0"/><TextBlock Grid.Column="2" Text="{Binding PercentageText}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StorageStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,2" />
                                <WrapPanel>
                                    <Button Content="清理当前账户行情缓存" Command="{Binding ClearMarketDataCacheCommand}" Padding="7,3" Margin="0,3,8,3" />
                                    <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="月度表现" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="当前筛选范围内，完整交易按最终平仓月汇总；点击月份查看交易。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding DashboardMonths}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding OpenCommand}" Padding="0" Margin="0,0,6,6" ToolTip="{Binding Detail}">
                                        <Border Background="{Binding Background}" CornerRadius="6" Padding="12,8" MinWidth="104">
                                            <StackPanel><TextBlock Text="{Binding Month}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                                <TextBlock Text="{Binding Value}" Foreground="{Binding Color}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,4"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="9"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,0">
                            <StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding DashboardBreakdownDimensions}" SelectedItem="{Binding DashboardBreakdownDimension}" AutomationProperties.Name="盈亏归因维度"/>
                                    <TextBlock Text="盈亏来源" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel>
                                <TextBlock Text="{Binding DashboardBreakdownSummary}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding DashboardBreakdown}" ItemTemplate="{StaticResource DashboardBarTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12">
                            <StackPanel><TextBlock Text="每笔盈亏分布" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="横条表示笔数；红盈绿亏。点击区间核对大赚、大亏和保本交易。" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PnlDistribution}" ItemTemplate="{StaticResource DashboardBarTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="原始费用拆分" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="仅汇总当前筛选 position 的成交；未映射费用保持账户级。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6"/><ItemsControl ItemsSource="{Binding FeeBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel><TextBlock Text="账户净值观测" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="账户级实际采样，含浮盈亏与出入金。" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6" TextWrapping="Wrap"/>
                                <controls:ReviewPerformanceChart Height="205" Series="{Binding AccountEquityChart}" AutomationProperties.Name="账户净值观测曲线"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="日历与日记" ToolTip="在日历选择日期，核对当日事实，填写日记并保存。完成日记需要盘后总结、做得好、需改进和下一次动作。现金盈亏按成交日汇总。">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="ReviewGuideCalendar" Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="‹" Command="{Binding PreviousCalendarMonthCommand}" IsEnabled="{Binding CanPreviousCalendarMonth}" Padding="8,4"/>
                                <Button DockPanel.Dock="Right" Content="›" Command="{Binding NextCalendarMonthCommand}" IsEnabled="{Binding CanNextCalendarMonth}" Padding="8,4"/>
                                <ComboBox ItemsSource="{Binding CalendarMonths}" SelectedItem="{Binding SelectedCalendarMonth}" Margin="6,0" AutomationProperties.Name="盈亏日历月份"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CalendarMonthSummary}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="日历使用账户全部成交；品种与策略筛选用于交易统计。" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CalendarWeekdays}" Margin="0,0,0,5"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="PnlCalendar" ItemsSource="{Binding CalendarMonthCells}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Margin="1" Padding="0" HorizontalContentAlignment="Stretch" ToolTip="{Binding Detail}">
                                        <Border Background="{Binding Background}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="5" Padding="4" MinHeight="91">
                                            <StackPanel><TextBlock Text="{Binding Day}" FontSize="11"/>
                                                <TextBlock Text="{Binding Pnl}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,4"/>
                                                <TextBlock Text="{Binding Trades}" Style="{StaticResource MutedTextStyle}" FontSize="8"/>
                                                <TextBlock Text="{Binding Pending}" Style="{StaticResource MutedTextStyle}" FontSize="8"/>
                                                <TextBlock Text="{Binding Journal}" Style="{StaticResource MutedTextStyle}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Gap}" Foreground="#E5B965" FontSize="8"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Grid><TextBlock Text="交易日日记" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding DailyStatus}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></Grid>
                        <TextBlock Text="日期" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding DailyDate}" Style="{StaticResource CompactInput}" IsReadOnly="True" ToolTip="从左侧日历选择日期，避免编辑身份与保存目标不一致"/>
                        <TextBlock Text="每日事实（点击日历日期刷新）" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding DailyFacts}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Expander Header="{Binding Title}" Margin="0,2"><Border BorderBrush="#253244" BorderThickness="1" CornerRadius="5" Padding="8"><StackPanel><TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></Expander>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="当日过程" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,4"/>
                        <ListView ItemsSource="{Binding DailyTimeline}" MaxHeight="185"><ListView.View><GridView><GridViewColumn Header="时间" Width="65" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="事件" Width="85" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="事实" Width="280" DisplayMemberBinding="{Binding Summary}"/><GridViewColumn Header="来源" Width="100" DisplayMemberBinding="{Binding Source}"/><GridViewColumn Header="交易" Width="75" DisplayMemberBinding="{Binding LinkedTrades}"/></GridView></ListView.View></ListView>
                        <TextBlock Text="盘前计划" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding PreMarketPlan}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                        <TextBlock Text="盘中笔记" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding IntradayNotes}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
                        <TextBlock Text="盘后总结" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding PostMarketSummary}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/>
