                                <ListView ItemsSource="{Binding BehaviorTradeLinks}" MaxHeight="155"><ListView.View><GridView><GridViewColumn Header="Position" Width="78" DisplayMemberBinding="{Binding PositionId}"/><GridViewColumn Header="角色" Width="76" DisplayMemberBinding="{Binding Role}"/><GridViewColumn Header="品种" Width="95" DisplayMemberBinding="{Binding Symbol}"/><GridViewColumn Header="方向" Width="45" DisplayMemberBinding="{Binding Side}"/><GridViewColumn Header="净盈亏" Width="70" DisplayMemberBinding="{Binding NetPnl}"/><GridViewColumn Header="档案" Width="52"><GridViewColumn.CellTemplate><DataTemplate><Button Content="打开" Command="{Binding OpenCommand}" Padding="5,2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="人工解释" Style="{StaticResource EditorLabel}"/>
