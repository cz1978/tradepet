<UserControl Language="{l:Language}" x:Class="TradePet.App.Views.ReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
             xmlns:controls="clr-namespace:TradePet.App.Controls"
             UseLayoutRounding="True">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveReviewCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding MarkReviewedCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousTradeCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextTradeCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,8,6" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="1,0,0,2" />
        </Style>
        <Style x:Key="FilterTextInput" TargetType="TextBox" BasedOn="{StaticResource CompactInput}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="FilterComboInput" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <Style x:Key="FilterPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,0" />
        </Style>
        <DataTemplate x:Key="DashboardBarTemplate">
            <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch" Padding="5,7" Margin="0,0,0,3" ToolTip="{Binding Detail, Converter={StaticResource UiTranslation}}">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value, Converter={StaticResource UiTranslation}}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Height="5" Margin="0,6,0,4" Background="#263142">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding FilledWidth}"/><ColumnDefinition Width="{Binding EmptyWidth}"/></Grid.ColumnDefinitions>
                        <Border Background="{Binding Color}" CornerRadius="2"/>
                    </Grid>
                    <TextBlock Text="{Binding Detail, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="ReviewStatusPanel" Margin="3,0,3,8">
            <TextBlock Text="{Binding StatusText, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EditorSaveStatus, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                       AutomationProperties.Name="{l:Text Key=Sbdefc0a1683bdb7a}" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Visibility="{Binding HasEditorSaveIssue, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <Button Content="{l:Text Key=Sc9875570f3e2e305}" Command="{Binding KeepLocalDraftCommand}" ToolTip="{l:Text Key=Sad6959f6c6e009e6}" Margin="0,0,6,0" />
                <Button Content="{l:Text Key=S84ffdc101087a8f7}" Command="{Binding DiscardAndReloadEditorCommand}" ToolTip="{l:Text Key=S2c10cc44b1933752}" />
                <TextBlock Text="{l:Text Key=Sb6384a4087139199}" Style="{StaticResource MutedTextStyle}" Margin="8,3,0,0" />
            </WrapPanel>
        </StackPanel>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                SelectedIndex="{Binding WorkspaceTabIndex, Mode=TwoWay}" SelectionChanged="WorkspaceTabs_SelectionChanged">
        <TabItem Header="{l:Text Key=Secd5b8d78e28a079}">
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding DashboardScope, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" Margin="3,7,3,10" TextWrapping="Wrap"/>
                    <Border x:Name="ReviewGuideFilters" Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Button Content="{l:Text Key=S88fa4983e683add4}" Command="{Binding RefreshCommand}" Style="{StaticResource FilterPrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Expander IsExpanded="False" Margin="0,0,100,0">
                                <Expander.Header><TextBlock Text="{l:Text Key=S070adaf3cdc22a2e}" FontWeight="SemiBold" Margin="0,7,0,7"/></Expander.Header>
                                <StackPanel Margin="0,10,-100,0">
                            <WrapPanel>
                                <StackPanel Width="190" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S59bcb6473f658a3f}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Text Key=S15e4d2434b1797d9}" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S55c280bf46551444}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Strategy}" ToolTip="{l:Text Key=S55c280bf46551444}" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S7b1013af7eae0c91}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Setup}" ToolTip="{l:Text Key=S7b1013af7eae0c91}" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=Sad2070538cf45a7b}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Tags}" ToolTip="{l:Text Key=S308b2ac85d1ef75d}" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="92" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S99a3c34b42d3db3a}" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding TagModeOptions}" SelectedItem="{Binding TagMode}" ToolTip="{l:Text Key=S214a41a8805edf2f}" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=Sea3ef37700a078be}" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="{l:Text Key=Sea3ef37700a078be}" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S941b07c1192e7acf}" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding AssessmentFilterOptions}" SelectedItem="{Binding AssessmentFilter}" ToolTip="{l:Text Key=S941b07c1192e7acf}" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="130" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S58631db7e4891478}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding CampaignFilter}" ToolTip="{l:Text Key=S58631db7e4891478}" Style="{StaticResource FilterTextInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=Sc41d329338a7c605}" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" ToolTip="{l:Text Key=Sc41d329338a7c605}" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S1c08e745a1715fb4}" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding ComparisonModeOptions}" SelectedItem="{Binding ComparisonMode}" ToolTip="{l:Text Key=S5bf4c344505157c5}" Style="{StaticResource FilterComboInput}"/></StackPanel>
                                <StackPanel Margin="0,0,0,6"><TextBlock Text="{l:Text Key=Sc8400937c7fa2bfc}" Style="{StaticResource FilterLabel}"/><Button Content="{l:Text Key=S88fa4983e683add4}" Command="{Binding RefreshCommand}" Style="{StaticResource FilterPrimaryButton}"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel><StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="{l:Text Key=Sf19ad3d483a0a7b0}" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding FilterName}" ToolTip="{l:Text Key=S9deaa1049ab5a4b8}" Style="{StaticResource FilterTextInput}"/></StackPanel><StackPanel Margin="0,0,8,6"><TextBlock Text="{l:Text Key=S6b755a1d299361bf}" Style="{StaticResource FilterLabel}"/><Button Content="{l:Text Key=S0d34bb3dfecbcef8}" Command="{Binding SaveFilterCommand}" Style="{StaticResource FilterButton}"/></StackPanel><ItemsControl ItemsSource="{Binding SavedFilters}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" ToolTip="{Binding Scope, Converter={StaticResource UiTranslation}}" Command="{Binding ApplyCommand}" Margin="0,3,5,6" Padding="7,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="ReviewGuideMetrics" ItemsSource="{Binding Metrics}" ToolTip="{l:Text Key=S7ded46eca7cbfeb4}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="11" MinHeight="82">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                                        <TextBlock Text="{Binding Value, Converter={StaticResource UiTranslation}}" Foreground="{Binding ValueColor}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Hint, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <ComboBox x:Name="PerformanceChartSelector" DockPanel.Dock="Right" Width="175" ItemsSource="{Binding PerformanceCharts}" SelectedItem="{Binding SelectedPerformanceChart}" AutomationProperties.Name="{l:Text Key=S6836f86a759b9b9f}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource UiTranslation}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="{l:Text Key=Sd5d01ae8e8be9ac5}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedPerformanceChart.Description, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <controls:ReviewPerformanceChart x:Name="PerformanceChart" Height="245" Series="{Binding SelectedPerformanceChart}" AutomationProperties.Name="{l:Text Key=S533e476492a65800}"/>
                            <TextBlock Text="{Binding SelectedPerformanceChart.SampleSummary, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8" Visibility="{Binding HasDashboardSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AnalysisDrilldownTitle, Converter={StaticResource UiTranslation}}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{l:Text Key=S6c3a4fadda4e629c}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,8"/>
                            <ListView ItemsSource="{Binding AnalysisDrilldown}" MaxHeight="195"><ListView.View><GridView>
                                <GridViewColumn Header="Position" Width="80" DisplayMemberBinding="{Binding PositionId}"/>
                                <GridViewColumn Header="{l:Text Key=S99ab695c245233f9}" Width="125" DisplayMemberBinding="{Binding ClosedAt}"/>
                                <GridViewColumn Header="{l:Text Key=S2b0abb7bb8ff7c99}" Width="95" DisplayMemberBinding="{Binding Symbol}"/>
                                <GridViewColumn Header="{l:Text Key=S99a8b38806d6b5a5}" Width="50" DisplayMemberBinding="{Binding Side}"/>
                                <GridViewColumn Header="{l:Text Key=S66973c7ea00e9a13}" Width="85" DisplayMemberBinding="{Binding NetPnl}"/>
                                <GridViewColumn Header="{l:Text Key=S4cdb93bff547d0d7}" Width="60"><GridViewColumn.CellTemplate><DataTemplate><Button Content="{l:Text Key=Sd6efd29f85a8d16a}" Command="{Binding OpenCommand}" Padding="7,2"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView></ListView.View></ListView>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DashboardRiskMetrics}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8" Padding="10">
                                <StackPanel><TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                    <TextBlock Text="{Binding Value, Converter={StaticResource UiTranslation}}" Foreground="{Binding ValueColor}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,3"/>
                                    <TextBlock Text="{Binding Hint, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{l:Text Key=Sd098e1c8d09a1cc5}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{l:Text Key=S4d0144af29e55bef}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8"/>
                                <ItemsControl ItemsSource="{Binding DashboardInsights}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{l:Text Key=S22eca0b60bcaa9fa}" Command="{Binding OpenCommand}" Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" Padding="6,2"/>
                                            <TextBlock Text="{Binding Title, Converter={StaticResource UiTranslation}}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                            <TextBlock Text="{Binding Detail, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ReviewGuideQuality" Text="{l:Text Key=S07bd38283a442e89}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding QualitySummary, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding Quality}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Command="{Binding OpenCommand}" ToolTip="{Binding Detail, Converter={StaticResource UiTranslation}}" Padding="3" Margin="0,1" HorizontalContentAlignment="Stretch">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}"/><TextBlock Grid.Column="1" Text="{Binding Fraction, Converter={StaticResource UiTranslation}}" Foreground="#AAB4C0"/><TextBlock Grid.Column="2" Text="{Binding PercentageText, Converter={StaticResource UiTranslation}}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StorageStatus, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,2" />
                                <WrapPanel>
                                    <Button Content="{l:Text Key=S8ef64d4723646baf}" Command="{Binding ClearMarketDataCacheCommand}" Padding="7,3" Margin="0,3,8,3" />
                                    <TextBlock Text="{Binding CacheStatus, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="{l:Text Key=Sadea165a8a763413}" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{l:Text Key=S638ed7c627d673d3}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding DashboardMonths}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding OpenCommand}" Padding="0" Margin="0,0,6,6" ToolTip="{Binding Detail, Converter={StaticResource UiTranslation}}">
                                        <Border Background="{Binding Background}" CornerRadius="6" Padding="12,8" MinWidth="104">
                                            <StackPanel><TextBlock Text="{Binding Month, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                                <TextBlock Text="{Binding Value, Converter={StaticResource UiTranslation}}" Foreground="{Binding Color}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,4"/>
                                                <TextBlock Text="{Binding Detail, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="9"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,0">
                            <StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding DashboardBreakdownDimensions}" SelectedItem="{Binding DashboardBreakdownDimension}" AutomationProperties.Name="{l:Text Key=S0f64708f07a6b2d6}"/>
                                    <TextBlock Text="{l:Text Key=S2c18f119eadd6551}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel>
                                <TextBlock Text="{Binding DashboardBreakdownSummary, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding DashboardBreakdown}" ItemTemplate="{StaticResource DashboardBarTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12">
                            <StackPanel><TextBlock Text="{l:Text Key=S2429011bcf646fa0}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{l:Text Key=Sd34d254d2eed0ebc}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding PnlDistribution}" ItemTemplate="{StaticResource DashboardBarTemplate}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="{l:Text Key=S3c7a44baf55a29b1}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{l:Text Key=S9ab34560ace69fed}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6"/><ItemsControl ItemsSource="{Binding FeeBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="85"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}"/><TextBlock Grid.Column="1" Text="{Binding Value, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding Hint, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel><TextBlock Text="{l:Text Key=S91e9951d4ab2e25c}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{l:Text Key=S2ee52dd1784389b2}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,6" TextWrapping="Wrap"/>
                                <controls:ReviewPerformanceChart Height="205" Series="{Binding AccountEquityChart}" AutomationProperties.Name="{l:Text Key=Sdbc0f1dfdad0dcba}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:Text Key=Scfb1be38db84b258}" ToolTip="{l:Text Key=Sb428e0ddab4a0bb4}">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="ReviewGuideCalendar" Style="{StaticResource PageCardStyle}" Padding="10" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="‹" Command="{Binding PreviousCalendarMonthCommand}" IsEnabled="{Binding CanPreviousCalendarMonth}" Padding="8,4"/>
                                <Button DockPanel.Dock="Right" Content="›" Command="{Binding NextCalendarMonthCommand}" IsEnabled="{Binding CanNextCalendarMonth}" Padding="8,4"/>
                                <ComboBox ItemsSource="{Binding CalendarMonths}" SelectedItem="{Binding SelectedCalendarMonth}" Margin="6,0" AutomationProperties.Name="{l:Text Key=S52a059b11874aa7b}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CalendarMonthSummary, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="{l:Text Key=Sf304f2538a6cd63f}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CalendarWeekdays}" Margin="0,0,0,5"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UiTranslation}}" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="PnlCalendar" ItemsSource="{Binding CalendarMonthCells}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Margin="1" Padding="0" HorizontalContentAlignment="Stretch" ToolTip="{Binding Detail, Converter={StaticResource UiTranslation}}">
                                        <Border Background="{Binding Background}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="5" Padding="4" MinHeight="91">
                                            <StackPanel><TextBlock Text="{Binding Day, Converter={StaticResource UiTranslation}}" FontSize="11"/>
                                                <TextBlock Text="{Binding Pnl, Converter={StaticResource UiTranslation}}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,4"/>
                                                <TextBlock Text="{Binding Trades, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="8"/>
                                                <TextBlock Text="{Binding Pending, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}" FontSize="8"/>
                                                <TextBlock Text="{Binding Journal}" Style="{StaticResource MutedTextStyle}" FontSize="8" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Gap, Converter={StaticResource UiTranslation}}" Foreground="#E5B965" FontSize="8"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
