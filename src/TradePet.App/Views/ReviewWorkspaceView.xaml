                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Text="名称" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding TradingSessionName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
