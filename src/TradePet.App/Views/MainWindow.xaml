<Window Language="{l:Language}" x:Class="TradePet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        xmlns:controls="clr-namespace:TradePet.App.Controls"
        xmlns:views="clr-namespace:TradePet.App.Views"
        Title="{l:Text Key=S350ce565e947d392}" Icon="/TradePet;component/Assets/tradepet-icon.ico"
        Width="1040" Height="696" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="ReviewCategoryPanelTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding ReviewCategories}"
                         SelectedItem="{Binding SelectedReviewCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource ReviewCategoryTabStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="25" Height="25" CornerRadius="7" Background="#20342F"
                                        BorderBrush="#31574D" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label, Converter={StaticResource UiTranslation}}" Margin="7,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText, Converter={StaticResource UiTranslation}}" Foreground="#718091"
                                           FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Background="#0F1620" BorderBrush="#202B3A" BorderThickness="1"
                        CornerRadius="10" Padding="12" Margin="0,1,7,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedReviewCategory.Icon, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedReviewCategory.Label, StringFormat={l:Text Key=Sc04166e303b2e25b}, Converter={StaticResource UiTranslation}}"
                                           FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedReviewCategory.Hint, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,4,10,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#263142" BorderThickness="1,0,0,0" Padding="13,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Text Key=S90edc19eafc3bcb4}" Style="{StaticResource MutedTextStyle}" FontSize="9" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedReviewCategory.BestGroup, Converter={StaticResource UiTranslation}}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    <TextBlock Text="{Binding SelectedReviewCategory.BestNetPnl, Converter={StaticResource UiTranslation}}"
                                               Foreground="{Binding SelectedReviewCategory.BestNetPnlColor}"
                                               FontWeight="SemiBold" Margin="7,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#263142" BorderThickness="1,0,0,0" Padding="13,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Text Key=S307305e37397de72}" Style="{StaticResource MutedTextStyle}" FontSize="9" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedReviewCategory.MostActiveGroup, Converter={StaticResource UiTranslation}}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    <TextBlock Text="{Binding SelectedReviewCategory.MostActiveTrades, Converter={StaticResource UiTranslation}}" Foreground="#AAB7C4"
                                               FontSize="10" Margin="7,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#0C121B" BorderBrush="#202B3A" BorderThickness="1"
                        CornerRadius="10" Margin="0,0,7,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Background="#101823" Height="37">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text Key=S5cf917fa38c3343e}" Style="{StaticResource MutedTextStyle}" Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{l:Text Key=Sbc39a72a6d8c5fe2}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{l:Text Key=S84ca5c99f5ae546c}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{l:Text Key=S66973c7ea00e9a13}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{l:Text Key=S2cf789917bfbd4d8}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{l:Text Key=S1b956e8c9d9b25da}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding VisibleReviewGroups}"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  Visibility="{Binding SelectedReviewCategory.HasGroups, Converter={StaticResource BoolToVisibility}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#182230" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Group, Converter={StaticResource UiTranslation}}" Margin="12,0" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Group, Converter={StaticResource UiTranslation}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Trades, Converter={StaticResource UiTranslation}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WinRate, Converter={StaticResource UiTranslation}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding NetPnl, Converter={StaticResource UiTranslation}}" Foreground="{Binding NetPnlColor}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding ProfitFactor, Converter={StaticResource UiTranslation}}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Expectancy, Converter={StaticResource UiTranslation}}" Foreground="{Binding ExpectancyColor}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="{l:Text Key=S4676a6011a04d50e}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedReviewCategory.HasNoGroups, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="#202A38" BorderThickness="0,0,1,0">
            <Grid Margin="15,18,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="142" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#19241F"
                                BorderBrush="#3B4A3F" BorderThickness="1">
                            <TextBlock Text="{l:Text Key=Sebf93e00b644f759}" Foreground="{StaticResource GoldBrush}" FontSize="17"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Text Key=S5c9484c45f7e3920}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="{l:Text Key=Sdea3b260dd0bd28a}" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <controls:PetSpriteControl Grid.Row="1" Width="118" Height="128"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Activity="{Binding PetActivity}"
                                           AtlasPath="Assets/baoer-pet/spritesheet.webp"
                                           PlaybackRate="0.65" />

                <ListBox x:Name="NavigationList" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SideNavItemStyle}"
                         SelectedIndex="{Binding ElementName=MainTabs, Path=SelectedIndex, Mode=TwoWay}">
                    <ListBoxItem Content="{l:Text Key=S9dd8a635443930be}" />
                    <ListBoxItem Content="{l:Text Key=S57375aa8783db9b0}" />
                    <ListBoxItem Content="{l:Text Key=S39f12fd8d6936711}" />
                    <ListBoxItem Content="{l:Text Key=S2b9f7901b72f0549}" />
                    <ListBoxItem Content="{l:Text Key=S67819401c5dcb20e}" />
                    <ListBoxItem Content="{l:Text Key=Secaf64d1186a8269}" />
                    <ListBoxItem Content="{l:Text Key=S22d7af3b431e1994}" />
                </ListBox>

                <Border x:Name="GuideConnectionStatus" Grid.Row="3" Style="{StaticResource PageCardStyle}" Padding="12" Background="#101821">
                    <StackPanel>
                        <TextBlock Text="{l:Text Key=S60810f961fdc4b1a}" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ConnectionText, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}"
                                       TextTrimming="CharacterEllipsis" Width="126" />
                        </StackPanel>
                        <TextBlock Text="{Binding BridgeText, Converter={StaticResource UiTranslation}}" Style="{StaticResource MutedTextStyle}"
                                   Margin="14,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AccountLabel, Converter={StaticResource UiTranslation}}" Foreground="#C7D1CD" FontSize="11"
                                   Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Margin="22,16,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GreetingText, Converter={StaticResource UiTranslation}}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{l:Text Key=Sa19e2b2857f341a3}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{l:Text Key=S1c669c747bc4052e}" Foreground="#546170" FontSize="11" />
                        <TextBlock Text="{Binding ServerDateText, Converter={StaticResource UiTranslation}}" Foreground="#AEBBB5" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GuideReplayButton" Content="{l:Text Key=S1d36f11481771ca2}" Click="StartGuide_Click" Style="{StaticResource QuietButtonStyle}" />
                    <Button x:Name="GuideFocusButton" Content="{l:Text Key=S9517a69c74e322c2}" Command="{Binding ToggleFocusCommand}" Style="{StaticResource QuietButtonStyle}" />
                    <Button Content="{l:Text Key=S1f0a04e1b6ca5d8b}" Click="HideWindow_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="22,0,22,10"
                        Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="{l:Text Key=S9dd8a635443930be}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{l:Text Key=Sd4ba8744c0c35757}"
                                       TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"
                                       Visibility="{Binding MonitoringOnly, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{l:Text Key=Se44e647e4fadd563}"
                                       TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12"
                                       Visibility="{Binding IsMt4, Converter={StaticResource BoolToVisibility}}" />
                            <UniformGrid x:Name="GuideOverviewMetrics" Columns="4" Margin="0,0,0,12">
                                <Border Style="{StaticResource MetricCardStyle}" Background="{Binding TotalPnlBackground}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Text Key=Sf7e6146c1c2156c5}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock
                                        Foreground="{Binding TotalPnlColor}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                                    <Binding Path="SupportsTradeHistory"/>
                                                    <Binding Path="TotalPnl"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Text Key=S3e5980c636a0e92b}" Foreground="#608E81" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Text Key=S862f4c5ec0813af2}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock
                                        Foreground="{Binding RealizedPnlColor}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                                    <Binding Path="SupportsTradeHistory"/>
                                                    <Binding Path="RealizedPnl"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Text Key=S4fe6cbcdf3c5656f}" Foreground="#65719C" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Text Key=S27dadce3ee3bca2a}" Style="{StaticResource MutedTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock  Foreground="{StaticResource GoldBrush}"
                                            FontSize="25" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="0.##">
                                                        <Binding Path="SupportsTradeHistory"/>
                                                        <Binding Path="TradeCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{l:Text Key=S189ba26c333f581f}" Foreground="#8B826C" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Text Key=S6072c933ec67ae1f}" Foreground="#8B826C" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PageCardStyle}" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="{l:Text Key=S3584ce01013d64cd}" Style="{StaticResource MutedTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock  Foreground="{Binding ConsecutiveLossesColor}"
                                            FontSize="25" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="0.##">
                                                        <Binding Path="SupportsTradeHistory"/>
                                                        <Binding Path="ConsecutiveLosses"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{l:Text Key=S189ba26c333f581f}" Foreground="#987272" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Text Key=S119f958233394a47}" Foreground="#987272" FontSize="10" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PageCardStyle}" Margin="0,0,10,0" MinHeight="195">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{l:Text Key=Sc04bdce4d8106dc7}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{l:Text Key=Sf3cdfdee33506c7f}" Style="{StaticResource MutedTextStyle}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,15,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition />
                                                <ColumnDefinition /><ColumnDefinition Width="1.1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{l:Text Key=S2b0abb7bb8ff7c99}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{l:Text Key=S99a8b38806d6b5a5}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="2" Text="{l:Text Key=S3a3c0f49569fc529}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="3" Text="{l:Text Key=Se9155716d392fa18}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="4" Text="{l:Text Key=Sa8c31c4d515f1591}" Style="{StaticResource MutedTextStyle}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Positions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0F1620" BorderBrush="#202A38" BorderThickness="0,1,0,0" Padding="0,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition />
                                                                <ColumnDefinition /><ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Symbol, Converter={StaticResource UiTranslation}}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Side, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Volume, Converter={StaticResource UiTranslation}}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Profit, Converter={StaticResource UiTranslation}}" Foreground="{Binding ProfitColor}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Duration, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource MutedBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding HasNoPositions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Text Key=Sd2211fb82f4f5698}" Foreground="#718078" FontSize="13" HorizontalAlignment="Center" />
                                            <TextBlock Text="{l:Text Key=S51f1bb678067d026}" Style="{StaticResource MutedTextStyle}"
                                                       FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource PageCardStyle}" MinHeight="195">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:Text Key=S06e4388483b2341f}" Style="{StaticResource SectionTitleStyle}" />
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="92" Height="92" CornerRadius="46" BorderBrush="#295D54" BorderThickness="9"
                                                    Background="#0E171A">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{l:Text Key=S1dbec8e3ac292955}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding RiskText, Converter={StaticResource UiTranslation}}" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="70" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{l:Text Key=S79a5381eb88b6e43}" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Foreground="{Binding WinCountColor}" FontSize="17" Margin="0,4,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="0.##">
                                                            <Binding Path="SupportsTradeHistory"/>
                                                            <Binding Path="WinCount"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{l:Text Key=S03a197b2184eeed2}" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Foreground="{Binding LossCountColor}" FontSize="17" Margin="0,4,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="0.##">
                                                            <Binding Path="SupportsTradeHistory"/>
                                                            <Binding Path="LossCount"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PageCardStyle}" Padding="15">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="{l:Text Key=S663a93763dc1f6de}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Foreground="{Binding HighWaterPnlColor}" FontSize="17" Margin="0,5,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource HistoryMetric}" ConverterParameter="+0.##;-0.##;0">
                                                    <Binding Path="SupportsTradeHistory"/>
                                                    <Binding Path="HighWaterPnl"/>
                                                </MultiBinding>
