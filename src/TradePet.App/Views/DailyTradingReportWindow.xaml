<Window Language="{l:Language}" x:Class="TradePet.App.Views.DailyTradingReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        Title="{l:Text Key=S7482b58d44b922f6}"
        Width="1040" Height="800"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="False" ShowActivated="False"
        Background="#101720">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#162231" />
            <Setter Property="BorderBrush" Value="#2A3A4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A3B5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#F2F5F4" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="AccountText" Foreground="#91A3B5" FontSize="12" Margin="0,5,0,0" />
                <TextBlock Text="{l:Text Key=S85a4c574c48c3678}" Foreground="#91A3B5" FontSize="12" TextWrapping="Wrap" Margin="0,5,12,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1E443D" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" Foreground="#65D9BE" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <TabControl x:Name="ReportTabs" Grid.Row="1" Margin="0,16,0,0"
                    Background="#101720" BorderThickness="0" Padding="0">
        <TabItem Header="{l:Text Key=Sbc815726b5f1ce2b}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,10,0">
        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="18">
            <StackPanel>
                <TextBlock Text="{l:Text Key=S3ff400b97b8fda42}" Style="{StaticResource MutedText}" />
                <TextBlock x:Name="NetPnlText" FontSize="34" FontWeight="Bold" Margin="0,3,0,4" />
                <TextBlock x:Name="SummaryText" Foreground="#C4D0DA" TextWrapping="Wrap" />
                <TextBlock Text="{l:Text Key=Sd1349183652c9398}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="{l:Text Key=S730e3ce6d28b42c3}" Style="{StaticResource MutedText}"/><TextBlock x:Name="TradeCountText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="{l:Text Key=S84ca5c99f5ae546c}" Style="{StaticResource MutedText}"/><TextBlock x:Name="WinRateText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="{l:Text Key=S51e4b7a0a765177c}" Style="{StaticResource MutedText}"/><TextBlock x:Name="WinLossText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="0,0,0,10">
                <StackPanel ToolTip="{l:Text Key=S0570c12447e7ac55}"><TextBlock Text="{l:Text Key=Sf0c0dd23d1acd416}" Style="{StaticResource MutedText}"/><TextBlock x:Name="FeesText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="{l:Text Key=S9527bfbf28340451}" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="BestTradeText" Foreground="#65D9BE" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="{l:Text Key=Se72d58b6c57f5d38}" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="WorstTradeText" Foreground="#F06B78" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:Text Key=S2008cc4a68121fa0}" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ProcessText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="{l:Text Key=DailyReportReviewTitle}" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ReviewText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,4" />
                    <TextBlock x:Name="TradeReviewText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <Button x:Name="BeginDailyReviewButton" Content="{l:Text Key=DailyReportBeginReview}" Click="BeginDailyReview_Click"
                            HorizontalAlignment="Left" Padding="12,6" Margin="0,7,0,12" />
                    <TextBlock Text="{l:Text Key=Sf9e3f6e326c7582a}" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="BehaviorText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl x:Name="AnalysisSections">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title, Converter={StaticResource UiTranslation}}" Foreground="#65D9BE" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource UiTranslation}}" Foreground="#D2DDE6" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Text Key=Sd6212b3cdb8d1f51}">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="TradeDetailHint" TextWrapping="Wrap" Foreground="#91A3B5" Margin="0,0,0,10"/>
                <DataGrid x:Name="TradeDetailsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" FrozenColumnCount="2" SelectionMode="Extended"
                          EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="#101720" Foreground="#D2DDE6" BorderBrush="#2A3A4D"
                          RowBackground="#162231" AlternatingRowBackground="#192839" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#2A3A4D" VerticalGridLinesBrush="#2A3A4D" MinRowHeight="36">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1C2B3A"/>
                            <Setter Property="Foreground" Value="#D2DDE6"/>
                            <Setter Property="BorderBrush" Value="#2A3A4D"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="6,4"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Position" Binding="{Binding PositionId, Converter={StaticResource UiTranslation}}" Width="95"/>
                        <DataGridTextColumn Header="{l:Text Key=S2b0abb7bb8ff7c99}" Binding="{Binding Symbol, Converter={StaticResource UiTranslation}}" Width="100"/>
                        <DataGridTextColumn Header="{l:Text Key=S99a8b38806d6b5a5}" Binding="{Binding Direction, Converter={StaticResource UiTranslation}}" Width="65"/>
                        <DataGridTextColumn Header="{l:Text Key=S5c9df444d27bb807}" Binding="{Binding OpenedAt, Converter={StaticResource UiTranslation}}" Width="160"/>
                        <DataGridTextColumn Header="{l:Text Key=S82dfacfbcdb6e742}" Binding="{Binding ClosedAt, Converter={StaticResource UiTranslation}}" Width="160"/>
                        <DataGridTextColumn Header="{l:Text Key=Sa8c31c4d515f1591}" Binding="{Binding Holding, Converter={StaticResource UiTranslation}}" Width="140"/>
                        <DataGridTextColumn Header="{l:Text Key=Sb4ca9b00e99160d8}" Binding="{Binding OpeningVolume, Converter={StaticResource UiTranslation}}" Width="90"/>
                        <DataGridTextColumn Header="{l:Text Key=Sff03b07b66e943c8}" Binding="{Binding MaximumVolume, Converter={StaticResource UiTranslation}}" Width="90"/>
                        <DataGridTextColumn Header="{l:Text Key=S66973c7ea00e9a13}" Binding="{Binding NetPnl, Converter={StaticResource UiTranslation}}" Width="140"/>
                        <DataGridTextColumn Header="{l:Text Key=Se575aa24a7d4303b}" Binding="{Binding Fees, Converter={StaticResource UiTranslation}}" Width="140"/>
                        <DataGridTextColumn Header="{l:Text Key=S3370f613d86136bf}" Binding="{Binding InitialRisk, Converter={StaticResource UiTranslation}}" Width="150"/>
                        <DataGridTextColumn Header="{l:Text Key=S53897397f8250df9}" Binding="{Binding ActualR, Converter={StaticResource UiTranslation}}" Width="95"/>
                        <DataGridTextColumn Header="{l:Text Key=Seb902e90073c6b79}" Binding="{Binding Mae, Converter={StaticResource UiTranslation}}" Width="150"/>
                        <DataGridTextColumn Header="{l:Text Key=S8acba80af91e31be}" Binding="{Binding Mfe, Converter={StaticResource UiTranslation}}" Width="150"/>
                        <DataGridTextColumn Header="{l:Text Key=S86516bba3d8e8cdf}" Binding="{Binding Giveback, Converter={StaticResource UiTranslation}}" Width="150"/>
                        <DataGridTextColumn Header="{l:Text Key=Sd10e4313eab98f53}" Binding="{Binding Coverage, Converter={StaticResource UiTranslation}}" Width="210"/>
                        <DataGridTextColumn Header="{l:Text Key=S5412a0b0eb453f43}" Binding="{Binding Protection, Converter={StaticResource UiTranslation}}" Width="300"/>
                        <DataGridTextColumn Header="{l:Text Key=S900fe9de29fc5898}" Binding="{Binding ExitReason}" Width="300"/>
                        <DataGridTextColumn Header="{l:Text Key=S2b241ff3cb5afcc4}" Binding="{Binding NextAction}" Width="360"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem x:Name="DailyReviewTab" Header="{l:Text Key=DailyReportReviewTitle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DailyReviewForm" Margin="0,10,10,0">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Text Key=DailyReportReviewGuide}" Foreground="#C4D0DA" TextWrapping="Wrap" />
                            <TextBlock x:Name="DailyReviewStatusText" Foreground="#65D9BE" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:Text Key=DailyReportSummaryLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBox x:Name="DailySummaryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{l:Text Key=DailyReportActionLabel}" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                    <ComboBox x:Name="DailyActionChoices" SelectionChanged="DailyActionChoices_SelectionChanged" Margin="0,0,0,6" />
                    <TextBox x:Name="DailyActionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                    <Button x:Name="SaveDailyReviewButton" Content="{l:Text Key=DailyReportSaveReview}" Click="SaveDailyReview_Click"
                            HorizontalAlignment="Left" Padding="14,7" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:Text Key=S627b311098aa0522}">
            <TextBox x:Name="FullReportText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="13" Padding="14" Margin="0,10,0,0"/>
        </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="2,10,0,14">
            <TextBlock Text="{l:Text Key=Saf1f7339974da5ae}" Foreground="#71869A" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="ArchivePathText" Foreground="#71869A" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Text Key=S29fc31858688cca1}" Click="CopyMarkdown_Click" Padding="14,7" />
            <Button Content="{l:Text Key=S086583b10061f85f}" Click="SaveMarkdown_Click" ToolTip="{l:Text Key=S0d6f135bd0f3b956}" Padding="14,7" Margin="10,0,0,0" />
            <Button Content="{l:Text Key=S4480a1203ab30b6d}" Click="OpenReview_Click" Padding="16,7" Margin="10,0,0,0" />
            <Button Content="{l:Text Key=Sa331f15358cb0cf7}" Click="Close_Click" Padding="18,7" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
