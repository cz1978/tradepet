<Window x:Class="TradePet.App.Views.DailyTradingReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="交易日报"
        Width="1040" Height="800"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="False" ShowActivated="False"
        Background="#101720">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#162231" />
            <Setter Property="BorderBrush" Value="#2A3A4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A3B5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#F2F5F4" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="AccountText" Foreground="#91A3B5" FontSize="12" Margin="0,5,0,0" />
                <TextBlock Text="按服务器交易日统计。查看各页后，可在右下角导出完整 MD 或复制报告给 AI。" Foreground="#91A3B5" FontSize="12" TextWrapping="Wrap" Margin="0,5,12,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1E443D" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" Foreground="#65D9BE" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <TabControl x:Name="ReportTabs" Grid.Row="1" Margin="0,16,0,0"
                    Background="#101720" BorderThickness="0" Padding="0">
        <TabItem Header="概览与建议">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,10,0">
        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="18">
            <StackPanel>
                <TextBlock Text="当日成交净盈亏（含费用）" Style="{StaticResource MutedText}" />
                <TextBlock x:Name="NetPnlText" FontSize="34" FontWeight="Bold" Margin="0,3,0,4" />
                <TextBlock x:Name="SummaryText" Foreground="#C4D0DA" TextWrapping="Wrap" />
                <TextBlock Text="按服务器日期统计。胜率和最佳 / 最差交易只计当日完整平仓；跨日、部分平仓可能使交易合计与当日成交净额不同。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="当日完整平仓" Style="{StaticResource MutedText}"/><TextBlock x:Name="TradeCountText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="胜率" Style="{StaticResource MutedText}"/><TextBlock x:Name="WinRateText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel><TextBlock Text="胜 / 负" Style="{StaticResource MutedText}"/><TextBlock x:Name="WinLossText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="0,0,0,10">
                <StackPanel ToolTip="佣金、隔夜费和其他费的净额，保留原始正负号；正数表示净入账。"><TextBlock Text="费用净额" Style="{StaticResource MutedText}"/><TextBlock x:Name="FeesText" Foreground="#F2F5F4" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="最好交易" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="BestTradeText" Foreground="#65D9BE" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="最差交易" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="WorstTradeText" Foreground="#F06B78" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="持仓过程采样" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ProcessText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="复盘进度" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ReviewText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <TextBlock Text="行为提醒" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="BehaviorText" Foreground="#F2F5F4" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl x:Name="AnalysisSections">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="#65D9BE" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#D2DDE6" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="逐笔交易与风险">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="TradeDetailHint" TextWrapping="Wrap" Foreground="#91A3B5" Margin="0,0,0,10"/>
                <DataGrid x:Name="TradeDetailsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" FrozenColumnCount="2" SelectionMode="Extended"
                          EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="#101720" Foreground="#D2DDE6" BorderBrush="#2A3A4D"
                          RowBackground="#162231" AlternatingRowBackground="#192839" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#2A3A4D" VerticalGridLinesBrush="#2A3A4D" MinRowHeight="36">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1C2B3A"/>
                            <Setter Property="Foreground" Value="#D2DDE6"/>
                            <Setter Property="BorderBrush" Value="#2A3A4D"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="6,4"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Position" Binding="{Binding PositionId}" Width="95"/>
                        <DataGridTextColumn Header="品种" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="65"/>
                        <DataGridTextColumn Header="开仓（服务器）" Binding="{Binding OpenedAt}" Width="160"/>
                        <DataGridTextColumn Header="平仓（服务器）" Binding="{Binding ClosedAt}" Width="160"/>
                        <DataGridTextColumn Header="持仓时长" Binding="{Binding Holding}" Width="140"/>
                        <DataGridTextColumn Header="开仓手数" Binding="{Binding OpeningVolume}" Width="90"/>
                        <DataGridTextColumn Header="最大手数" Binding="{Binding MaximumVolume}" Width="90"/>
                        <DataGridTextColumn Header="净盈亏" Binding="{Binding NetPnl}" Width="140"/>
                        <DataGridTextColumn Header="已记录费用" Binding="{Binding Fees}" Width="140"/>
                        <DataGridTextColumn Header="初始风险" Binding="{Binding InitialRisk}" Width="150"/>
                        <DataGridTextColumn Header="实际 R" Binding="{Binding ActualR}" Width="95"/>
                        <DataGridTextColumn Header="MAE（最低盈亏）" Binding="{Binding Mae}" Width="150"/>
                        <DataGridTextColumn Header="MFE（最高盈亏）" Binding="{Binding Mfe}" Width="150"/>
                        <DataGridTextColumn Header="浮盈回吐" Binding="{Binding Giveback}" Width="150"/>
                        <DataGridTextColumn Header="采样覆盖" Binding="{Binding Coverage}" Width="210"/>
                        <DataGridTextColumn Header="实际 SL/TP 记录" Binding="{Binding Protection}" Width="300"/>
                        <DataGridTextColumn Header="已记录退出原因" Binding="{Binding ExitReason}" Width="300"/>
                        <DataGridTextColumn Header="下一步" Binding="{Binding NextAction}" Width="360"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="完整日报 / Markdown">
            <TextBox x:Name="FullReportText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="13" Padding="14" Margin="0,10,0,0"/>
        </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="2,10,0,14">
            <TextBlock Text="统计基于交易服务器日；未完成持仓不计入胜率，缺失数据不补零。MT4 按已平仓订单票据计数。" Foreground="#71869A" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="ArchivePathText" Foreground="#71869A" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制给 AI" Click="CopyMarkdown_Click" Padding="14,7" />
            <Button Content="导出 MD" Click="SaveMarkdown_Click" ToolTip="选择保存位置，导出完整 Markdown 交易日报" Padding="14,7" Margin="10,0,0,0" />
            <Button Content="打开复盘" Click="OpenReview_Click" Padding="16,7" Margin="10,0,0,0" />
            <Button Content="关闭" Click="Close_Click" Padding="18,7" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
