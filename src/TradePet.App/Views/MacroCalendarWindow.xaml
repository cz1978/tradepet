<Window Language="{l:Language}" x:Class="TradePet.App.Views.MacroCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        Title="{l:Text Key=Sfd62c7a47ec1aa6a}"
        Width="760" Height="720" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#101720" Topmost="True">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA2B5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Text Key=Sfd62c7a47ec1aa6a}" Foreground="#F2F5F4" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="SourceText" Text="{l:Text Key=Sc0dfb4a6df3154cb}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1A2A39" CornerRadius="12" Padding="11,6" VerticalAlignment="Top">
                <TextBlock x:Name="SummaryText" Foreground="#65D9BE" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#121C28" BorderBrush="#28394B" BorderThickness="1" CornerRadius="14" Margin="0,18,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#263748" BorderThickness="0,0,0,1" Padding="15,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TimeText, Converter={StaticResource UiTranslation}}" Foreground="#F2F5F4" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CountryText, Converter={StaticResource UiTranslation}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ImportanceText, Converter={StaticResource UiTranslation}}" Foreground="{Binding ImportanceColor}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,16,0">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource UiTranslation}}" Foreground="#F2F5F4" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusText, Converter={StaticResource UiTranslation}}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{l:Text Key=S092b193501348716}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding PreviousText, Converter={StaticResource UiTranslation}}" Foreground="#D9E2E8" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{l:Text Key=S89a4eeb08582790c}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ForecastText, Converter={StaticResource UiTranslation}}" Foreground="#D9E2E8" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{l:Text Key=S863730e2e0816b1b}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ActualText, Converter={StaticResource UiTranslation}}" Foreground="#65D9BE" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="ReminderText" Text="{l:Text Key=S084ed9c87d82dc9a}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Content="{l:Text Key=Sa331f15358cb0cf7}" HorizontalAlignment="Right" Padding="18,7" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
