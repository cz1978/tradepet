<Window Language="{l:Language}" x:Class="TradePet.App.Views.MiniPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        Width="330" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <Border Background="#E8121923" BorderBrush="#35465B" BorderThickness="1" CornerRadius="11" Padding="10">
        <StackPanel>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Foreground="#F2F5F4" FontWeight="SemiBold">
                    <Run Text="{l:Text Key=S34cf427c9de59b50}"/><Run Text="{Binding OpenPositionCount, Converter={StaticResource UiTranslation}}"/><Run Text="{l:Text Key=S87455fe80228f23c}"/>
                    <Run Text="{Binding FloatingPnl, StringFormat={}{0:+0.##;-0.##;0}, Converter={StaticResource UiTranslation}}" Foreground="{Binding FloatingPnlColor}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding PositionDataStatus, Converter={StaticResource UiTranslation}}" Foreground="#F0B85C" FontSize="10" Margin="8,0"/>
                <Button Grid.Column="2" Click="Pin_Click" Padding="5,1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="{l:Text Key=Scf9d10a0af0389f8}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="ToolTip" Value="{l:Text Key=S6676a4ad4d61db13}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MiniPositionPinned, Converter={StaticResource UiTranslation}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Background" Value="#1B6655"/>
                                    <Setter Property="BorderBrush" Value="#58C6A5"/>
                                    <Setter Property="ToolTip" Value="{l:Text Key=S12aeb01068fc5d6a}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="3" Content="{l:Text Key=S05610c9ab38c8dcb}" Click="Hide_Click" Padding="5,1" Margin="5,0,0,0" ToolTip="{l:Text Key=S0690e6ff4198689a}"/>
            </Grid>
            <TextBlock Text="{Binding PositionCard, Converter={StaticResource UiTranslation}}" Foreground="#AAB7C4" FontSize="10" Margin="0,5,0,0"/>
            <Expander Header="{l:Text Key=S1c649d863af408de}" Visibility="{Binding HasPositions, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
                <ItemsControl ItemsSource="{Binding Positions}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="55"/><ColumnDefinition Width="60"/><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Symbol, Converter={StaticResource UiTranslation}}" Foreground="#EEF3F1"/>
                            <TextBlock Grid.Column="1" Text="{Binding Side, Converter={StaticResource UiTranslation}}" Foreground="#AAB7C4"/>
                            <TextBlock Grid.Column="2" Text="{Binding Profit, Converter={StaticResource UiTranslation}}" Foreground="{Binding ProfitColor}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Duration, Converter={StaticResource UiTranslation}}" Foreground="#8491A0"/>
                            <TextBlock Grid.Column="4" Text="{Binding StopLossStatus, Converter={StaticResource UiTranslation}}" Foreground="#F0B85C" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Border>
</Window>
