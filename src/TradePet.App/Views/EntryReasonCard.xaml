<UserControl Language="{l:Language}" x:Class="TradePet.App.Views.EntryReasonCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
             Width="360" UseLayoutRounding="True">
    <StackPanel Margin="14">
        <TextBlock Text="{l:Text Key=S8a1409a7b5e1f104}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="TradeText" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
        <TextBlock Text="{l:Text Key=Sa7fb1c424c712b87}" FontSize="12" TextWrapping="Wrap" />
        <WrapPanel Margin="0,8,0,3">
            <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="FontSize" Value="12"/></Style></WrapPanel.Resources>
            <Button Content="{l:Text Key=Seab80fa2804aaaf3}" Tag="突破入场" Click="Reason_Click"/><Button Content="{l:Text Key=S5ce3a1fd724b0e97}" Tag="回踩入场" Click="Reason_Click"/>
            <Button Content="{l:Text Key=S590a4bc7e3c6b92b}" Tag="区间反转入场" Click="Reason_Click"/><Button Content="{l:Text Key=Sd4294347777d0d50}" Tag="跟随趋势入场" Click="Reason_Click"/>
            <Button Content="{l:Text Key=S327a8a5f1565c781}" Tag="消息驱动入场" Click="Reason_Click"/><Button Content="{l:Text Key=Secb31b47f1749aaa}" Tag="试探性入场" Click="Reason_Click"/>
        </WrapPanel>
        <TextBlock x:Name="ChosenReasonText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
        <Expander Header="{l:Text Key=S006cb4d19e8681c9}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" IsExpanded="False">
            <TextBox x:Name="ReasonBox" MaxLength="500" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Reason_TextChanged" Margin="0,7,0,0"/>
        </Expander>
        <TextBlock x:Name="StatusText" Foreground="#F3A4A0" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
        <StackPanel x:Name="FooterButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:Text Key=S0d8ce6fef045f498}" Click="Skip_Click" Padding="9,5"/>
            <Button x:Name="RecordReasonButton" Content="{l:Text Key=S5c4aee017b29bcb4}" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
