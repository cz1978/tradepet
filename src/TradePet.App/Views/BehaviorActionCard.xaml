<UserControl Language="{l:Language}" x:Class="TradePet.App.Views.BehaviorActionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TradePet.App.Localization" Width="360" UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="FormScroll" MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Form">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <Expander x:Name="SummaryDetails" Header="{l:Text Key=PetGoalSummaryDetails}" Visibility="Collapsed" Margin="0,0,0,4">
                    <TextBlock x:Name="SummaryDetailsText" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,4"/>
                </Expander>
                <StackPanel x:Name="ChoiceGroups"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,9,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel x:Name="FooterButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                <Button Content="{l:Text Key=PetActionClose}" Click="Close_Click" Margin="0,0,7,0" Padding="12,6"/>
                <Button x:Name="SaveButton" Click="Save_Click" Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
