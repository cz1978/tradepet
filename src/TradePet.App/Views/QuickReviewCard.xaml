<UserControl x:Class="TradePet.App.Views.QuickReviewCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Background="Transparent" UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="平仓后快速复盘" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="TradeText" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="平仓原因（自动推测，点选可修正）" FontSize="12" />
                <TextBlock Text="{Binding Text, ElementName=ExitReasonBox}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,4" />
                <WrapPanel Margin="0,3,0,0">
                    <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="FontSize" Value="11"/></Style></WrapPanel.Resources>
                    <Button Content="触发止盈" Tag="触发预设止盈价，自动平仓" Click="ReasonPreset_Click" />
                    <Button Content="触发止损" Tag="触发预设止损价，自动平仓" Click="ReasonPreset_Click" />
                    <Button Content="手动止盈" Tag="主动平仓，兑现盈利" Click="ReasonPreset_Click" />
                    <Button Content="手动止损" Tag="主动平仓，接受当前亏损" Click="ReasonPreset_Click" />
                    <Button Content="手动保本" Tag="接近保本时主动平仓" Click="ReasonPreset_Click" />
                </WrapPanel>
                <TextBlock Text="改进事项（自动生成）" FontSize="12" Margin="0,5,0,4" />
                <TextBlock Text="{Binding Text, ElementName=ImproveBox}" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                <Expander Header="自动复盘依据" Foreground="#AAB7C4" FontSize="11" Margin="0,9,0,0" IsExpanded="False">
                    <TextBlock x:Name="AnalysisText" Foreground="#7FB7A9" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </Expander>
                <Expander Header="手写补充 / 修改（可选）" Foreground="#AAB7C4" FontSize="11" Margin="0,7,0,0" IsExpanded="False">
                    <StackPanel>
                        <TextBlock Text="平仓原因" FontSize="11" Margin="0,6,0,4" />
                        <TextBox x:Name="ExitReasonBox" MinHeight="38" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="改进事项" FontSize="11" Margin="0,6,0,4" />
                        <TextBox x:Name="ImproveBox" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="SaveStatusText" Foreground="#F3A4A0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" />
            <DockPanel x:Name="FooterButtons" LastChildFill="False">
                <Button Content="交易档案" Click="SavedReviews_Click" DockPanel.Dock="Left" Padding="7,5" FontSize="11" Margin="0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="跳过" Click="Skip_Click" Padding="7,5" FontSize="11" Margin="0,0,5,0" />
                    <Button Content="稍后" Click="Later_Click" Padding="7,5" FontSize="11" Margin="0,0,5,0" />
                    <Button x:Name="QuickSaveButton" Content="保存复盘" Click="Save_Click" Padding="9,5" FontSize="11" Margin="0" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
