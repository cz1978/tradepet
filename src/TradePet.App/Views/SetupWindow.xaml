<Window Language="{l:Language}" x:Class="TradePet.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TradePet.App.Localization"
        Title="{l:Text Key=Sb91e5f04e0ba6605}" Width="760" Height="670" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{l:Text Key=Sbbf71e3b3a9bc735}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{l:Text Key=Scfb4f5708ed0f228}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>
            <TextBlock x:Name="StepLabel" Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>
        <ScrollViewer x:Name="StepScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="PlatformStep">
                    <TextBlock Text="{l:Text Key=S1a3480dcb199ce75}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{l:Text Key=Sb90f44048eaa2e2d}" TextWrapping="Wrap" Margin="0,12,0,18"/>
                    <ComboBox x:Name="PlatformPicker" ItemsSource="{Binding PlatformOptions}"
                              SelectedValuePath="Value" SelectedValue="{Binding SelectedPlatform, Mode=TwoWay}" SelectionChanged="Platform_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock x:Name="PlatformDescription" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,20"/>
                    <TextBlock Text="{l:Text Key=S598a992e48b8ddfb}" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TerminalOptions}" SelectedValuePath="Path"
                              SelectedValue="{Binding SelectedTerminalPath, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource UiTranslation}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock Text="{Binding SelectedTerminalPath, Converter={StaticResource UiTranslation}}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,12" Foreground="{StaticResource MutedBrush}"/>
                    <WrapPanel><Button Content="{l:Text Key=S7ae881b7e14d8bc5}" Click="Refresh_Click"/><Button Content="{l:Text Key=S203c30780f65549c}" Click="Browse_Click"/></WrapPanel>
                    <TextBlock Text="{l:Text Key=Sb3d23c313ef28434}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                </StackPanel>
                <StackPanel x:Name="PrepareStep" Visibility="Collapsed">
                    <TextBlock Text="{l:Text Key=Sb4c29378b43bbf93}" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel x:Name="PythonPanel" Margin="0,14,0,18">
                        <TextBlock x:Name="PythonDescription" Text="{l:Text Key=Sce5791a103ac3551}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0"><Button Content="{l:Text Key=Sf4b13a0922d919ec}" Click="CheckPython_Click"/><WrapPanel x:Name="ExternalPythonActions"><Button Content="{l:Text Key=S86268ad76ed59ffe}" Click="RepairPython_Click"/><Button Content="{l:Text Key=Sf7f8565c5b565fb2}" Click="BrowsePython_Click"/></WrapPanel></WrapPanel>
                        <TextBlock x:Name="PythonStatus" Text="{l:Text Key=S20cf1302d542f312}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="BridgeInstructions" TextWrapping="Wrap" Margin="0,14,0,16"/>
                    <WrapPanel><Button Content="{l:Text Key=S63c52bac9a0a4f37}" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{l:Text Key=S8ba340cbcf111479}" Click="OpenData_Click"/></WrapPanel>
                    <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>
                <StackPanel x:Name="VerifyStep" Visibility="Collapsed">
                    <TextBlock Text="{l:Text Key=Sc9f7a7fd62335f1d}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{l:Text Key=S940c38ad8eb68961}" TextWrapping="Wrap" Margin="0,14,0,20"/>
                    <TextBlock Text="{Binding ConnectionText, Converter={StaticResource UiTranslation}}" FontSize="17"/>
                    <TextBlock Text="{Binding BridgeText, Converter={StaticResource UiTranslation}}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding AccountLabel, Converter={StaticResource UiTranslation}}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding DiagnosticText, Converter={StaticResource UiTranslation}}" TextWrapping="Wrap" Margin="0,12,0,16" Style="{StaticResource MutedTextStyle}"/>
                    <Button Content="{l:Text Key=S5a168f1e12b3f5f4}" Click="CheckConnection_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ConnectionCheck" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="{l:Text Key=S45d49011c7f9e74c}" TextWrapping="Wrap" Margin="0,20,0,0" Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>
                <StackPanel x:Name="PreferencesStep" Visibility="Collapsed">
                    <TextBlock Text="{l:Text Key=Sb6c6a08a3ad51b35}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                    <TextBlock Text="{l:Text Key=Sfc18f936c8bab1d5}" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding UiLanguageOptions}" SelectedValuePath="Code" SelectedValue="{Binding UiLanguage}" Width="220" HorizontalAlignment="Left" Margin="0,5,0,12">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="{l:Text Key=S9ab7648e208b0224}" IsChecked="{Binding IsTopmost}"/>
                    <CheckBox Content="{l:Text Key=S7f86eaa5db5a5f74}" IsChecked="{Binding MiniPositionVisible}"/>
                    <CheckBox Content="{l:Text Key=S3c75ec103e4868fb}" IsChecked="{Binding IsFocusMode}"/>
                    <CheckBox Content="{l:Text Key=Sd3ddc5206b2af7cc}" IsChecked="{Binding ExpandCardOnHover}"/>
                    <CheckBox Content="{l:Text Key=S36fa06144a4fc61d}" IsChecked="{Binding StartWithWindows}"/>
                    <TextBlock Text="{l:Text Key=Sda7d82318eca3713}" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,7"/>
                    <Slider Minimum="0.4" Maximum="1.5" Value="{Binding PetScale}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{l:Text Key=S0218dff10ed3dbff}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                    <TextBlock Text="{l:Text Key=S3aeeb58e5c2ff204}" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Margin="0,16,0,12" Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="3">
            <Button x:Name="LaterButton" Content="{l:Text Key=S992b43609f3ed35a}" HorizontalAlignment="Left" Click="Later_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{l:Text Key=Sd57ced27d9d76ca3}" Click="Back_Click"/>
                <Button x:Name="NextButton" Content="{l:Text Key=S2b241ff3cb5afcc4}" Click="Next_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
