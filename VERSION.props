<Project>
  <PropertyGroup>
    <VersionPrefix>1.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <InformationalVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</InformationalVersion>
    <TradePetReleaseChannel>stable</TradePetReleaseChannel>
    <TradePetSchemaVersion>11</TradePetSchemaVersion>
    <TradePetProtocolVersion>1.0</TradePetProtocolVersion>
    <TradePetWorkerVersion>0.1.0</TradePetWorkerVersion>
    <TradePetHistoryWorkerVersion>1.0.0</TradePetHistoryWorkerVersion>
    <TradePetReviewExportFormatVersion>1</TradePetReviewExportFormatVersion>
    <TradePetBackupFormatVersion>1</TradePetBackupFormatVersion>
  </PropertyGroup>
</Project>
